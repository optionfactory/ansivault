<!-- Plugin Configuration File. Read more: https://plugins.jetbrains.com/docs/intellij/plugin-configuration-file.html -->
<idea-plugin>
    <id>net.optionfactory.jetbrains.ansivault</id>
    <name>AnsiVault</name>
    <vendor>OptionFactory</vendor>

    <depends>com.intellij.modules.platform</depends>

    <extensions defaultExtensionNs="com.intellij">
        <projectConfigurable
                parentId="tools"
                instance="net.optionfactory.jetbrains.ansivault.configuration.ProjectConfigurable"
                id="net.optionfactory.jetbrains.ansivault.configuration.ProjectConfigurable"
                displayName="AnsiVault Configuration"
        />
        <editorFactoryListener implementation="net.optionfactory.jetbrains.ansivault.gutter.VaultGutterListener"/>
        <projectService serviceImplementation="net.optionfactory.jetbrains.ansivault.ui.VaultFragmentService"/>
        <projectService serviceImplementation="net.optionfactory.jetbrains.ansivault.configuration.VaultSettings"/>
        <notificationGroup id="AnsiVault" displayType="BALLOON"/>
    </extensions>
    <actions>
        <group id="ansivault">
            <add-to-group group-id="ToolsMenu" anchor="first"/>
        </group>

        <action id="Ansivault.Vault"
                class="net.optionfactory.jetbrains.ansivault.actions.VaultAction"
                text="Ansible Vault Encrypt/Decrypt"
                description="Encrypt or decrypt the selection; without a selection, open the vault at the caret or encrypt the YAML value at the caret"
                icon="/icons/icon.svg">
            <add-to-group group-id="ansivault" anchor="first"/>
            <add-to-group group-id="EditorPopupMenu" anchor="last"/>
            <keyboard-shortcut keymap="$default" first-keystroke="ctrl alt shift A"/>
            <keyboard-shortcut keymap="Mac OS X 10.5+" first-keystroke="meta alt shift A"/>
        </action>


    </actions>
</idea-plugin>
